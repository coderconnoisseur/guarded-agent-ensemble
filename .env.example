# Copy this file to .env and fill in what you need. .env is gitignored, and a
# value here takes precedence over anything exported in your shell - so a
# stale exported key cannot silently shadow a good one.

# ---------------------------------------------------------------------------
# REQUIRED: Groq. https://console.groq.com/keys  (free, no card)
# ---------------------------------------------------------------------------
# Everything runs on Groq by default. The pinned backbone is
# qwen/qwen3.8-27b, and two auxiliary safety models used by the defenses live
# on the same key:
#   openai/gpt-oss-safeguard-20b         Harm Gate stage 2 classifier
#   meta-llama/llama-prompt-guard-2-86m  Response Firewall guard model
#
# Free-tier limits MEASURED from Groq's own response headers, not the docs:
#   qwen/qwen3.8-27b  1000 requests/day, 8000 tokens/min, per model
#   prompt-guard      14400 requests/day
# The binding constraint is an output-tokens-per-minute ceiling of 1000, which
# works out at ~2 requests/minute. A full benchmark run takes hours, not
# minutes. See docs/REPRODUCING.md before starting one.
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL: fallback providers
# ---------------------------------------------------------------------------
# Only used if you pass --use-chain, or set BACKBONE_PROVIDER below. Leave
# blank and everything still works.

# https://openrouter.ai/keys - 50 requests/day per ACCOUNT without credits,
# 1000/day after a one-time $10 top-up.
OPENROUTER_API_KEY=

# https://aistudio.google.com/apikey - MEASURED at 20 requests/day PER MODEL,
# not the several hundred secondary sources report. The API named its own
# limit in a 429 body.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL: overrides. Defaults live in config/settings.py with the
# measurement that produced each one in a comment beside it.
# ---------------------------------------------------------------------------
# Swap the backbone. Changing this invalidates every prior measurement in
# results/ - re-run the baseline if you touch it.
# BACKBONE_MODEL=qwen/qwen3.8-27b
# BACKBONE_PROVIDER=groq

# Raise after buying OpenRouter credit.
# DAILY_REQUEST_CAP=50
# GROQ_DAILY_REQUEST_CAP=1000
# GEMINI_DAILY_REQUEST_CAP=20

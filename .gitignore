# Secrets
.env

# Third-party paper PDFs. Kept locally, never published: this repo is public
# and the six source papers are other people's copyrighted work under licences
# we have not individually verified. docs/papers/README.md says where to get
# each one.
docs/papers/*.pdf

# LLM client state (§5.2 points 3 & 4)
src/llm/cache/
src/llm/.budget.json

# Eval outputs
results/

# Sandbox mutable state (seed files are committed, agent writes are not)
sandbox/outbox.jsonl
sandbox/scratch/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Third-party benchmark data, fetched on demand by scripts/fetch_agentharm.py.
# AgentHarm ships a canary GUID to detect its prompts leaking into training
# corpora; copying 352 harmful prompts into a public repo is what that canary
# exists to discourage. Licence permits it, the commons does not.
external/
